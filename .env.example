# Пример файла .env для переопределения настроек из configs/app.json
# Скопируйте этот файл в .env и настройте под свои нужды

# Proxy настройки
PROXY_TIMEOUT_MS=5000
PROXY_MAX_BODY_SIZE_MB=10

# Token настройки
TOKEN_EXP=1440
TOKEN_REFRESH_EXP=10080
TOKEN_MAX_JWT_SIZE_BYTES=4096
TOKEN_ALG_SUPPORTED=HS256,HS512,RS256,RS512,ES256,ES512,EdDSA
TOKEN_TYP_SUPPORTED=JWT
TOKEN_IP_WHITELIST=127.0.0.1,10.0.0.0/24,192.168.1.0/24,192.168.0.1/24,172.17.0.1/24

# Redis настройки
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev
REDIS_DB=0
REDIS_KEY_PREFIX=go-proxy-guard:

# Logging настройки
LOGGING_LEVEL=info
LOGGING_OUTPUT=./proxy.log
LOGGING_FORMAT=json
LOGGING_ROTATION_MAX_SIZE_MB=100
LOGGING_ROTATION_MAX_AGE_DAYS=7
LOGGING_ROTATION_MAX_BACKUPS=10
LOGGING_ROTATION_COMPRESS=true

# Keys настройки
KEYS_DIR=./keys

# Мастер-ключ для шифрования ключей (ОБЯЗАТЕЛЬНО в продакшене!)
MASTER_KEY=your-master-key-here

# Другие настройки
LISTEN_ADDR=:8080
APP_CONFIG=configs/app.json
PROXY_CONFIG=configs/proxy.json
